# Example systemd unit. Change User/Group/WorkingDirectory/ExecStart before installing.
[Unit]
Description=CPRG 312 Portfolio Express API
After=network.target
[Service]
Type=simple
User=zhanght
WorkingDirectory=/home/zhanght/CPRG-312-A/server
Environment=NODE_ENV=production
Environment=SERVER_MODE=nginx-proxy
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
[Install]
WantedBy=multi-user.target
